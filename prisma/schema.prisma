// Schema Prisma — Operação Pipa (consulta de placas)
// Banco: MySQL/Railway (tabela `caminhoes`, DDL em src/infra/db/ddl.sql)
// URL de conexão: DATABASE_URL em .env (lida por prisma.config.ts).
//
// Nota: a tabela física não tem PK; `placa` é marcada como @unique apenas
// para satisfazer o Prisma (somente leitura — nunca rodar db push/migrate
// a partir deste schema sem revisar o banco antes).

datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

model Caminhao {
  lote          String? @db.VarChar(10)
  nome_condutor String? @db.VarChar(128)
  placa         String   @unique @db.VarChar(50)
  municipio_uf  String? @db.VarChar(50)

  @@map("caminhoes")
}
